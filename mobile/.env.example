# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# Local Supabase (run `npx supabase start` in the repo root, then use the values it prints):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from supabase start>
#
# Hosted project (Project Settings > API keys in the Supabase dashboard):
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
#
# The publishable key is safe in the app: it only allows what row-level security allows.
# Never put the secret/service-role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
